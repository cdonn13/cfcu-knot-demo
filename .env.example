# ── Mode ─────────────────────────────────────────────────────────
# mock (default) → embedded mock of Knot's API, zero credentials needed
# live           → real calls to https://development.knotapi.com
KNOT_MODE=mock

# ── Live-mode credentials (Knot Customer Dashboard) ──────────────
# KNOT_MODE=live
# KNOT_CLIENT_ID=your-client-id
# KNOT_SECRET=your-secret
# KNOT_ENVIRONMENT=development

# ── Deployment ───────────────────────────────────────────────────
# Public base URL of this app. The mock posts webhooks here; in live
# mode, register ${PUBLIC_URL}/webhooks/knot in the Knot dashboard.
# PUBLIC_URL=https://cfcu-knot-demo.onrender.com
# PORT=3000
